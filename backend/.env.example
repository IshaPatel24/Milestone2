# Environment
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=change-this-in-production-to-a-very-secure-random-32-byte-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=30

# Cookie Configuration
AUTH_COOKIE_NAME=patient_access_token
SECURE_COOKIES=false
COOKIE_SAMESITE=lax

# Database Configuration (SQLite stored in backend/data)
DATABASE_URL=sqlite:///./data/patient_portal.db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=15
