# ==============================================================================
# Aegis Health Patient Portal — Backend Environment Configuration
# Configure these variables in Vercel Project: "milestone2-api"
# ==============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=production
DEBUG=false

# ------------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Neon connection string (pooled connection recommended for serverless workloads)
# In development, leave empty to fall back to local SQLite: sqlite:///./data/patient_portal.db
DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Serverless connection pooling (True uses NullPool to prevent connection leaks across lambdas)
DB_POOL_NULL=true

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secure random 32+ character signing key (e.g. generated with `openssl rand -hex 32`)
SECRET_KEY=change-this-in-production-to-a-very-secure-random-32-byte-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# Cookie Configuration
# ------------------------------------------------------------------------------
AUTH_COOKIE_NAME=patient_access_token
# Set to 'true' in production (HTTPS)
SECURE_COOKIES=true
# Set to 'none' for cross-origin deployments (e.g. milestone2.vercel.app -> milestone2-api.vercel.app)
# Set to 'lax' for same-origin or local development
COOKIE_SAMESITE=none

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of trusted frontend origins
BACKEND_CORS_ORIGINS=https://milestone2.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Brute-force Rate Limiting
# ------------------------------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=30
